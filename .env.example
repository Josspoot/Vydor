# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore: nunca subas tu clave al repositorio.

# Obligatorio. Clave gratuita de Google AI Studio (NO requiere tarjeta):
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de voz. Es un modelo preview: si Google lo renombra, cámbialo aquí.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Voz del coach. Prueba varias en AI Studio antes de decidir: la calidad en
# español varía bastante entre ellas.
GEMINI_VOICE=Charon

# Frenos de gasto para cuando el demo esté desplegado en público.
MAX_SESSION_SECONDS=600
MAX_SESSIONS_PER_IP=20

LOG_LEVEL=INFO
